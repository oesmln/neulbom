# Public endpoint (host only, without https:// or a trailing slash)
PUBLIC_API_HOST=api.neulbom.example
NGINX_CONFIG_FILE=https.conf
TLS_CERTS_HOST_PATH=/opt/neulbom/certs
IMAGE_TAG=production

# PostgreSQL
POSTGRES_DB=neulbom
POSTGRES_USER=neulbom
POSTGRES_PASSWORD=
DB_POOL_MAX_SIZE=15
DB_POOL_MIN_IDLE=3

# Application secrets (generate independent random values of at least 32 characters)
JWT_SECRET=
AI_SERVER_SERVICE_TOKEN=
AI_AUDIO_SIGNING_SECRET=

# Public browser origins only. Native Android API calls do not depend on CORS.
CORS_ALLOWED_ORIGINS=https://api.neulbom.example

# AI model and runtime
AI_SERVER_MODEL_ARTIFACTS_HOST_PATH=/opt/neulbom/models
AI_SERVER_LOG_LEVEL=INFO
AI_SERVER_ANALYSIS_PROCESSING_TIMEOUT_SECONDS=300

# Google Cloud APIs. The backend uses the VM service account through ADC.
GOOGLE_STT_PROJECT_ID=
GOOGLE_TTS_PROJECT_ID=
GOOGLE_STT_LOCATION=us
GOOGLE_STT_MODEL=chirp_3
GOOGLE_STT_LANGUAGE=ko-KR

# Optional providers
GEMINI_API_KEY=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ALLOWED_REDIRECT_URIS=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_ALLOWED_REDIRECT_URIS=

# Optional SMTP
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
