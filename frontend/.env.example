# 비워 두면 번들된 mock API를 사용합니다. /api/v1은 앱 코드가 자동으로 붙입니다.
# iOS simulator / Expo Web
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Android emulator에서는 아래 주소를 사용합니다.
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# 실제 기기에서는 개발 PC의 LAN IP를 사용합니다.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8080

# EAS Preview에서는 EAS environment에 운영 호스트만 설정합니다.
# EXPO_PUBLIC_API_BASE_URL=https://api.neulbom.example

# OAuth 공개 설정. client secret은 프론트엔드에 절대 넣지 않습니다.
# Expo Web 로컬 callback은 실행 포트와 provider 콘솔 등록값이 정확히 같아야 합니다.
EXPO_PUBLIC_KAKAO_CLIENT_ID=
EXPO_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/auth/callback/kakao
EXPO_PUBLIC_KAKAO_AUTHORIZATION_ENDPOINT=https://kauth.kakao.com/oauth/authorize
EXPO_PUBLIC_NAVER_CLIENT_ID=
EXPO_PUBLIC_NAVER_REDIRECT_URI=http://localhost:3000/auth/callback/naver
EXPO_PUBLIC_NAVER_AUTHORIZATION_ENDPOINT=https://nid.naver.com/oauth2.0/authorize
