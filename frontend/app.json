{
  "expo": {
    "name": "메모케어",
    "slug": "memocare",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "memocare",
    "splash": {
      "backgroundColor": "#5A8F68"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5A8F68"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "음성 답변을 녹음하려면 마이크 접근 권한이 필요합니다."
        }
      ]
    ]
  }
}
