# syntax=docker/dockerfile:1

FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG EXPO_PUBLIC_API_BASE_URL
ARG EXPO_PUBLIC_KAKAO_CLIENT_ID
ARG EXPO_PUBLIC_KAKAO_REDIRECT_URI
ARG EXPO_PUBLIC_NAVER_CLIENT_ID
ARG EXPO_PUBLIC_NAVER_REDIRECT_URI

ENV EXPO_PUBLIC_API_BASE_URL=${EXPO_PUBLIC_API_BASE_URL} \
    EXPO_PUBLIC_KAKAO_CLIENT_ID=${EXPO_PUBLIC_KAKAO_CLIENT_ID} \
    EXPO_PUBLIC_KAKAO_REDIRECT_URI=${EXPO_PUBLIC_KAKAO_REDIRECT_URI} \
    EXPO_PUBLIC_NAVER_CLIENT_ID=${EXPO_PUBLIC_NAVER_CLIENT_ID} \
    EXPO_PUBLIC_NAVER_REDIRECT_URI=${EXPO_PUBLIC_NAVER_REDIRECT_URI}

RUN npx expo export --platform web --output-dir dist

FROM nginx:1.28-alpine

COPY --from=build /app/dist /usr/share/nginx/html

