# AI 서버 실행 환경: local, test, development, production
AI_SERVER_APP_ENV=local

# 로그 레벨: DEBUG, INFO, WARNING, ERROR, CRITICAL
AI_SERVER_LOG_LEVEL=INFO

# ai-server 디렉터리 기준 계약 파일 경로
AI_SERVER_CONTRACTS_DIR=contracts

# ai-server 디렉터리 기준 모델 아티팩트 경로
AI_SERVER_ARTIFACTS_DIR=artifacts/models

# 백엔드와 AI 서버 사이에서 사용하는 서비스 간 인증 토큰
# 운영 환경에서는 충분히 긴 무작위 문자열을 Secret으로 주입해야 함
AI_SERVER_SERVICE_TOKEN=replace-with-a-random-service-token

# 멱등 요청 기록을 저장할 SQLite 파일
AI_SERVER_IDEMPOTENCY_DB_PATH=data/idempotency.sqlite3

# signed URL 음성 다운로드 제한
AI_SERVER_AUDIO_DOWNLOAD_TIMEOUT_SECONDS=30
AI_SERVER_MAX_AUDIO_DOWNLOAD_BYTES=33554432

# 비동기 분석 작업과 상태를 저장할 SQLite 파일
AI_SERVER_ANALYSIS_DB_PATH=data/analyses.sqlite3

# 세션 분석 한 건의 최대 처리 시간
# OpenAPI의 x-processing-timeout-ms=300000과 동일한 300초
AI_SERVER_ANALYSIS_PROCESSING_TIMEOUT_SECONDS=300

# Docker 호스트에서 모델 아티팩트가 저장된 경로
# 실제 절대경로는 로컬 .env에만 작성
AI_SERVER_MODEL_ARTIFACTS_HOST_PATH=./artifacts/models

# Docker 호스트에 공개할 AI 서버 포트
AI_SERVER_PORT=8000