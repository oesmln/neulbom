# Application
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
APP_SCHEDULER_ENABLED=true
APP_DAILY_REPORT_CRON=0 5 0 * * *

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/neulbom
DB_USERNAME=kimminseo
DB_PASSWORD=
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT=30000
DB_POOL_MAX_LIFETIME=1800000
DB_SHOW_SQL=false

# Security - use a long random value outside Git
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=neulbom
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
PASSWORD_RESET_EMAIL_RATE_LIMIT_MAX_ATTEMPTS=3
PASSWORD_RESET_EMAIL_RATE_LIMIT_WINDOW=15m
PASSWORD_RESET_IP_RATE_LIMIT_MAX_ATTEMPTS=10
PASSWORD_RESET_IP_RATE_LIMIT_WINDOW=1h

# OAuth providers
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ALLOWED_REDIRECT_URIS=http://localhost:8081/auth/callback/kakao
KAKAO_TOKEN_URI=https://kauth.kakao.com/oauth/token
KAKAO_USER_INFO_URI=https://kapi.kakao.com/v2/user/me
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_ALLOWED_REDIRECT_URIS=http://localhost:8081/auth/callback/naver
NAVER_TOKEN_URI=https://nid.naver.com/oauth2.0/token
NAVER_USER_INFO_URI=https://openapi.naver.com/v1/nid/me

# File storage
FILE_STORAGE_TYPE=local
FILE_STORAGE_LOCAL_ROOT=./uploads
FILE_STORAGE_BUCKET=neulbom-local
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# External APIs
# STT_PROVIDER=auto selects OpenAI when configured, then local Whisper, then Google STT.
# Explicit values: openai, local, google, none
STT_PROVIDER=auto

# OpenAI-hosted Whisper (paid)
WHISPER_API_KEY=
WHISPER_API_BASE_URL=https://api.openai.com
WHISPER_MODEL=whisper-1

# Local Whisper server with an OpenAI-compatible /v1/audio/transcriptions endpoint
LOCAL_WHISPER_API_BASE_URL=
LOCAL_WHISPER_API_KEY=
LOCAL_WHISPER_MODEL=whisper-1

# Google Cloud Speech-to-Text V2 (uses Application Default Credentials)
GOOGLE_STT_BASE_URL=
GOOGLE_STT_PROJECT_ID=
GOOGLE_STT_LOCATION=asia-northeast1
GOOGLE_STT_MODEL=chirp_3
GOOGLE_STT_LANGUAGE_CODE=ko-KR
# Optional service-account JSON path; local gcloud ADC also works.
GOOGLE_APPLICATION_CREDENTIALS=

GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.5-flash
AST_API_URL=
AST_API_KEY=
AST_MODEL=v1
KCELECTRA_API_URL=
KCELECTRA_API_KEY=
KCELECTRA_MODEL=v1
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_TOKEN_URI=https://kauth.kakao.com/oauth/token
KAKAO_USER_INFO_URI=https://kapi.kakao.com/v2/user/me
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_TOKEN_URI=https://nid.naver.com/oauth2.0/token
NAVER_USER_INFO_URI=https://openapi.naver.com/v1/nid/me
EXTERNAL_API_CONNECT_TIMEOUT=3s
EXTERNAL_API_READ_TIMEOUT=30s
EXTERNAL_API_RETRY_COUNT=2
EXTERNAL_API_ALLOW_FALLBACK=true

# Upload and CORS
APP_MAX_UPLOAD_SIZE=25MB
APP_MAX_REQUEST_SIZE=30MB
APP_ALLOWED_FILE_EXTENSIONS=wav,mp3,m4a,webm
APP_ALLOWED_MIME_TYPES=audio/wav,audio/x-wav,audio/mpeg,audio/mp4,audio/webm
REQUEST_ID_HEADER=X-Request-Id
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-Id,Idempotency-Key

# Logging
SQL_LOG_LEVEL=WARN
SQL_BIND_LOG_LEVEL=WARN
