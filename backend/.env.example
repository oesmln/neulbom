# Application
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/neulbom
DB_USERNAME=kimminseo
DB_PASSWORD=
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT=30000
DB_POOL_MAX_LIFETIME=1800000
DB_SHOW_SQL=false

# Security - use a long random value outside Git
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# OAuth providers
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/callback/kakao
KAKAO_TOKEN_URI=https://kauth.kakao.com/oauth/token
KAKAO_USER_INFO_URI=https://kapi.kakao.com/v2/user/me
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/callback/naver
NAVER_TOKEN_URI=https://nid.naver.com/oauth2.0/token
NAVER_USER_INFO_URI=https://openapi.naver.com/v1/nid/me

# File storage
FILE_STORAGE_TYPE=local
FILE_STORAGE_LOCAL_ROOT=./uploads
FILE_STORAGE_BUCKET=neulbom-local
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# External APIs
WHISPER_API_KEY=
GEMINI_API_KEY=
AST_API_URL=
KCELECTRA_API_URL=
EXTERNAL_API_CONNECT_TIMEOUT=3s
EXTERNAL_API_READ_TIMEOUT=30s
EXTERNAL_API_RETRY_COUNT=2

# Upload and CORS
APP_MAX_UPLOAD_SIZE=25MB
APP_MAX_REQUEST_SIZE=30MB
APP_ALLOWED_FILE_EXTENSIONS=wav,mp3,m4a,webm
APP_ALLOWED_MIME_TYPES=audio/wav,audio/x-wav,audio/mpeg,audio/mp4,audio/webm
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-Id,Idempotency-Key
